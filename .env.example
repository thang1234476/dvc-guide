# Local Docker Compose
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=

# Optional credentials for creating the first administrator.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Use true and the admin HTTPS origin when deploying behind a TLS proxy.
ADMIN_SESSION_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=

# Host ports. MySQL is reached over the Compose network.
SERVER_HOST_PORT=8080
AI_HOST_PORT=8000
ADMIN_HOST_PORT=5173

# Use a model already installed in the Ollama instance.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=45
AI_SERVICE_TIMEOUT_SECONDS=55
# Generate a private value and use the same value for Spring Boot and TTHC_API_KEYS.
AI_SERVICE_API_KEY=
