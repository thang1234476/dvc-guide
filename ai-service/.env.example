# DVC Guide AI Service – Environment Variables Example
# Copy to .env and fill in your values
# NEVER commit .env to version control

# ─── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ─── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ─── Ollama (Local LLM) ────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
# Set to the name of a model already installed in Ollama.
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=45
OLLAMA_EMBED_MODEL=nomic-embed-text

# ─── Vector Database ────────────────────────────────────────────────────────────
VECTOR_DB_URL=http://localhost:6333
VECTOR_DB_COLLECTION=dvc_procedures

# ─── Spring Boot Backend ────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8080

# Same private key as AI_SERVICE_API_KEY on Spring Boot.
TTHC_API_KEYS=
# Optional: durable snapshot, separate from the original clean.json.
# TTHC_RUNTIME=/absolute/path/to/runtime/rag-state.json
