# ============================================================
# DVC Guide – Root .gitignore
# ============================================================

# ---- Environment & Secrets ----
.env
.env.local
.env.*.local
*.secret
*.key

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- IDE ----
.idea/
.vscode/
*.iml
*.iws
*.ipr
*.swp
*.swo
*~

# ============================================================
# Java / Spring Boot
# ============================================================
server/target/
server/.mvn/wrapper/maven-wrapper.jar
server/.mvn/wrapper/maven-wrapper.properties
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*

# ============================================================
# Flutter / Dart
# ============================================================
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
mobile/build/
mobile/pubspec.lock
mobile/.pub-cache/
mobile/.pub/
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/key.properties
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/ios/Flutter/Flutter.framework
mobile/ios/Flutter/Flutter.podspec
*.g.dart
*.freezed.dart

# ============================================================
# Python / FastAPI
# ============================================================
ai-service/__pycache__/
ai-service/*.py[cod]
ai-service/*$py.class
ai-service/.venv/
ai-service/venv/
ai-service/env/
ai-service/.env
ai-service/dist/
ai-service/build/
ai-service/*.egg-info/
ai-service/.pytest_cache/
ai-service/.mypy_cache/
ai-service/.ruff_cache/

# ---- Logs ----
*.log
logs/
