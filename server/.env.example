# Copy to .env. Spring Boot loads this file automatically at startup.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dvc_guide
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
SERVER_PORT=8080
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_SECONDS=55
# Must match a key in TTHC_API_KEYS on the AI service.
AI_SERVICE_API_KEY=
RAG_SYNC_ENABLED=true
RAG_SYNC_TIMEOUT_SECONDS=180

# Optional overrides.
# DB_URL=jdbc:mysql://localhost:3306/dvc_guide
# MariaDB/XAMPP uses the MariaDB driver and dialect.
# DB_URL='jdbc:mariadb://localhost:3306/dvc_guide?timezone=UTC'
# SPRING_JPA_DATABASE_PLATFORM=com.dvcguide.server.config.MariaDbJsonDialect
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# Set true when serving the admin site over HTTPS.
# ADMIN_SESSION_COOKIE_SECURE=true

# Optional first administrator. Set the password in the shell before startup.
# ADMIN_BOOTSTRAP_EMAIL=admin@example.com
