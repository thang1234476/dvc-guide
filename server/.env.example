# Copy to .env and export the variables before running Spring Boot.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dvc_guide
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
SERVER_PORT=8080
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_SECONDS=55

# Optional overrides.
# DB_URL=jdbc:mysql://localhost:3306/dvc_guide
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional first administrator. Set the password in the shell before startup.
# ADMIN_BOOTSTRAP_EMAIL=admin@example.com
